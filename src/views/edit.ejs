<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div id="header">
        <!-- Begin : nav -->
        <ul id="nav_bar">
            <li><a href="/new">HOME</a></li>
            <li><a href="/list">BAND</a></li>
            <li><a href="">TOUR</a></li>
            <li><a href="/create">CONTACT</a></li>
            <li>
                <a href="" class="dropdown-link">MORE</a>
                <ul class="sub_nav">
                    <li><a href="">Merchandise</a></li>
                    <li><a href="">Extras</a></li>
                    <li><a href="">Media</a></li>
                </ul>
            </li>
        </ul>
        <!-- End : nav -->

        <!-- Begin : search -->
        <div class=search-btn>
            <i class="search-icon ti-search"></i>
        </div>
        <!-- End : search -->
    </div>

    <div class="content-section">
        <h2 class="content-heading text-center" style="margin-top: 50px;">UPDATE</h2>
        <p class="content-slogan text-center">Update your info</p>
        <div class="contact-content">
            <div class="row">
                <div class="col col-sec contact-info">
                    <p><i class="ti-location-pin"></i>Chicago, US</p>
                    <p><i class="ti-mobile"></i>Phone: +00 151515</p>
                    <p><i class="ti-email"></i>Email: mail@mail.com</p>
                </div>
                <div class="col col-sec contact-form">
                    <form action="/create-user" method="post">
                        <div class="row">
                            <div class="col col-sec">
                                <input type="text" required placeholder="Name" name="name" id=""
                                    class="form-control" value="<%=selectedUser.name%>">
                            </div>
                            <div class="col col-sec">
                                <input type="email" required placeholder="Email" name="email" id="" class="form-control" value="<%=selectedUser.email%>">
                            </div>
                        </div>
                        <div class="row mt8">
                            <div class="col col-full">
                                <input type="text" required placeholder="Message" name="message" id=""class="form-control" value="<%=selectedUser.city%>">
                            </div>
                        </div>
                        <input type="submit" , class="btn float-r" value="SEND">
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>