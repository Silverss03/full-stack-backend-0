<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
    <div id="header">
        <!-- Begin : nav -->
        <ul id="nav_bar">
            <li><a href="/new">HOME</a></li>
            <li><a href="">BAND</a></li>
            <li><a href="">TOUR</a></li>
            <li><a href="/create">CONTACT</a></li>
            <li>
                <a href="" class="dropdown-link">MORE</a>
                <ul class="sub_nav">
                    <li><a href="">Merchandise</a></li>
                    <li><a href="">Extras</a></li>
                    <li><a href="">Media</a></li>
                </ul>
            </li>
        </ul>
        <!-- End : nav -->

        <!-- Begin : search -->
        <div class=search-btn>
            <i class="search-icon ti-search"></i>
        </div>
        <!-- End : search -->
    </div>

    <div class="table-container">
        <h2 style="margin-top: 50px;">List Users</h2>
        
        <table>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>City</th>
            <th>Action</th>
        </tr>
        <% for (let i = 0 ; i < listUsers.length ; i++) { %>
            <tr>
                <td><%= listUsers[i].id %></td>
                <td><%= listUsers[i].name %></td>
                <td><%= listUsers[i].email %></td>
                <td><%= listUsers[i].city %></td>
                <td><a style="padding: 6px 12px; margin-right: 12px;" href="\update\<%= listUsers[i].id %>">Edit</a>
                    <button style="padding: 6px 12px ">Delete</button>
                </td>
            </tr>
        <% } %>
        </table>
    </div>
</body>
</html>